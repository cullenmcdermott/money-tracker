# SimpleFIN access URL (https://user:pass@host/path). Get one with `pbpaste | just simplefin-claim`; see README.
# Public demo for local testing: https://demo:demo@beta-bridge.simplefin.org/simplefin
SIMPLEFIN_ACCESS_URL=
# Postgres connection string (required). `just pg` starts a local one at this address; `just dev` and `just db` default to it.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/money?sslmode=disable
ADDR=127.0.0.1:8188
# Nightly backups (gzipped tar of COPY dumps). BACKUP_TIME is HH:MM in the server's local time.
BACKUP_DIR=data/backups
BACKUP_KEEP=14
BACKUP_TIME=03:00
BACKUP_MAX_UPLOAD=1073741824

# Auth (OIDC, e.g. Pocket ID). Without these the app refuses to start unless AUTH_DISABLED=true.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=money-tracker
# OIDC_CLIENT_SECRET=          # optional: leave empty for a public client using PKCE
# OIDC_REDIRECT_URL=https://money.example.com/auth/callback
# SESSION_SECRET=              # openssl rand -base64 32
# OIDC_ALLOWED_EMAILS=me@example.com,other@example.com
# OIDC_ALLOWED_GROUPS=money
# Local development only (the justfile dev recipe sets this):
# AUTH_DISABLED=true

# Optional: TypeSafe Jev as a fallback for suggestions the local rules cannot make (see README). Off unless the key is set.
# JEV_API_KEY=
# JEV_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0.5
# JEV_HOME_LOCATION=Denver, Colorado
# JEV_PRICE_INPUT_PER_MTOK=0.042
# JEV_PRICE_OUTPUT_PER_MTOK=0
# JEV_URL=https://api.typesafe.ai/v1/systemone
